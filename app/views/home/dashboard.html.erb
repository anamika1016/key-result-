<%
  dashboard_time = Time.current.in_time_zone("Asia/Kolkata")
  status_tone = {
    "pending" => "amber", "confirmed" => "amber", "accepted" => "blue", "checked_in" => "green",
    "checked_out" => "slate", "rejected" => "red", "cancelled" => "red",
    "submitted" => "amber", "in_review" => "blue", "reopened" => "amber", "resolved" => "green", "closed" => "slate"
  }
  modules = [
    {
      key: "guest", title: "Guest House", link: admin_guest_house_bookings_path, link_label: "Admin Bookings",
      headline: @guest_house_booking_count, headline_label: "Total bookings",
      stats: [
        [ "Pending approval", @guest_house_pending_count ],
        [ "Checked in", @guest_house_checked_in_count ],
        [ "Checked out", @guest_house_checked_out_count ],
        [ "Payment pending", @guest_house_payment_pending_count ]
      ]
    },
    {
      key: "help", title: "Help Desk", link: help_desk_tickets_path, link_label: "Open Tickets",
      headline: @help_desk_total_count, headline_label: "Total tickets",
      stats: [
        [ "Open / in review", @help_desk_open_count ],
        [ "Unassigned", @help_desk_unassigned_count ],
        [ "Resolved", @help_desk_resolved_count ],
        [ "Closed", @help_desk_closed_count ]
      ]
    },
    {
      key: "training", title: "Training", link: trainings_path, link_label: "Online Training",
      headline: @training_total_count, headline_label: "Online trainings",
      stats: [
        [ "Active", @training_active_count ],
        [ "This month", @training_this_month_count ],
        [ "Completions", @training_completed_count ],
        [ "TOT records", @tot_record_count ]
      ]
    },
    {
      key: "quiz", title: "Quiz", link: quizzes_path, link_label: "Quiz Details",
      headline: @quiz_total_count, headline_label: "Total quizzes",
      stats: [
        [ "Active", @quiz_active_count ],
        [ "Participants", @quiz_participant_count ],
        [ "Submissions", @quiz_submission_count ],
        [ "Avg. score", @quiz_average_score || "—" ]
      ]
    }
  ]
%>

<div class="ops-dashboard">
  <section class="ops-hero">
    <div>
      <span class="ops-eyebrow">ASA Operations</span>
      <h1>Dashboard</h1>
      <p>Live summary of Guest House, Help Desk, Training, Quiz and Employees.</p>
    </div>
    <div class="ops-clock">
      <div class="ops-clock__time" id="dashboard-live-clock"><%= dashboard_time.strftime("%I:%M:%S %p") %></div>
      <div class="ops-clock__date"><%= dashboard_time.strftime("%A, %d %B %Y") %></div>
    </div>
  </section>

  <section class="ops-summary">
    <%= link_to employee_details_path, class: "ops-summary__card" do %>
      <span class="ops-summary__label">Employees</span>
      <span class="ops-summary__value"><%= number_with_delimiter(@total_employee_details) %></span>
      <span class="ops-summary__meta"><%= number_with_delimiter(@total_users) %> login users</span>
    <% end %>
    <%= link_to guest_houses_path, class: "ops-summary__card" do %>
      <span class="ops-summary__label">Guest Houses</span>
      <span class="ops-summary__value"><%= @guest_house_count %></span>
      <span class="ops-summary__meta"><%= @guest_house_total_rooms %> rooms · <%= @guest_house_today_checkins %> check-ins today</span>
    <% end %>
    <%= link_to user_training_assignments_path, class: "ops-summary__card" do %>
      <span class="ops-summary__label">Training Assignments</span>
      <span class="ops-summary__value"><%= number_with_delimiter(@training_assignment_count) %></span>
      <span class="ops-summary__meta"><%= @training_in_progress_count %> in progress</span>
    <% end %>
    <%= link_to help_desk_tickets_path, class: "ops-summary__card" do %>
      <span class="ops-summary__label">Open Tickets</span>
      <span class="ops-summary__value"><%= @help_desk_open_count %></span>
      <span class="ops-summary__meta"><%= @help_desk_unassigned_count %> unassigned</span>
    <% end %>
  </section>

  <section class="ops-modules">
    <% modules.each do |mod| %>
      <article class="ops-module ops-module--<%= mod[:key] %>">
        <header>
          <h2><%= mod[:title] %></h2>
          <%= link_to "#{mod[:link_label]} →", mod[:link], class: "ops-module__link" %>
        </header>
        <div class="ops-module__headline">
          <strong><%= number_with_delimiter(mod[:headline]) %></strong>
          <span><%= mod[:headline_label] %></span>
        </div>
        <dl class="ops-module__stats">
          <% mod[:stats].each do |label, value| %>
            <div>
              <dt><%= label %></dt>
              <dd><%= value.is_a?(Numeric) ? number_with_delimiter(value) : value %></dd>
            </div>
          <% end %>
        </dl>
      </article>
    <% end %>
  </section>

  <section class="ops-lists">
    <article class="ops-list">
      <header>
        <h2>Recent Guest House Bookings</h2>
        <%= link_to "All records →", records_guest_house_bookings_path, class: "ops-module__link" %>
      </header>
      <% if @recent_guest_house_bookings.any? %>
        <ul>
          <% @recent_guest_house_bookings.each do |booking| %>
            <li>
              <%= link_to guest_house_booking_path(booking), class: "ops-list__row" do %>
                <span>
                  <strong><%= booking.requester_name %></strong>
                  <small><%= booking.booking_reference_label %> · <%= booking.guest_house&.name %></small>
                </span>
                <span class="ops-badge ops-badge--<%= status_tone.fetch(booking.status, "slate") %>"><%= booking.status.humanize %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="ops-empty">No bookings yet.</p>
      <% end %>
    </article>

    <article class="ops-list">
      <header>
        <h2>Recent Help Desk Tickets</h2>
        <%= link_to "All tickets →", help_desk_tickets_path, class: "ops-module__link" %>
      </header>
      <% if @recent_help_desk_tickets.any? %>
        <ul>
          <% @recent_help_desk_tickets.each do |ticket| %>
            <li>
              <%= link_to help_desk_ticket_path(ticket), class: "ops-list__row" do %>
                <span>
                  <strong><%= ticket.requester_name %></strong>
                  <small><%= ticket.request_type.to_s.humanize %> · <%= ticket.created_at.in_time_zone("Asia/Kolkata").strftime("%d %b %Y") %></small>
                </span>
                <span class="ops-badge ops-badge--<%= status_tone.fetch(ticket.status, "slate") %>"><%= ticket.status.humanize %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="ops-empty">No tickets yet.</p>
      <% end %>
    </article>
  </section>
</div>

<style>
  .ops-dashboard { display: flex; flex-direction: column; gap: 20px; padding: 4px; color: #0f172a; }
  .ops-hero { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding: 24px 28px; border-radius: 18px; color: #fff; background: linear-gradient(120deg, #1e3a8a 0%, #2563eb 55%, #0ea5e9 100%); box-shadow: 0 12px 30px rgba(37, 99, 235, .22); }
  .ops-eyebrow { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; opacity: .85; }
  .ops-hero h1 { margin: 4px 0 6px; font-size: 30px; font-weight: 800; }
  .ops-hero p { margin: 0; opacity: .9; }
  .ops-clock { text-align: right; }
  .ops-clock__time { font-size: 26px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .ops-clock__date { font-size: 13px; opacity: .85; }

  .ops-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
  .ops-summary__card { display: flex; flex-direction: column; gap: 4px; padding: 18px 20px; border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; text-decoration: none; color: inherit; transition: box-shadow .15s, transform .15s; }
  .ops-summary__card:hover { box-shadow: 0 8px 22px rgba(15, 23, 42, .08); transform: translateY(-1px); }
  .ops-summary__label { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #64748b; }
  .ops-summary__value { font-size: 30px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .ops-summary__meta { font-size: 13px; color: #64748b; }

  .ops-modules { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .ops-module { padding: 20px; border: 1px solid #e2e8f0; border-top: 4px solid var(--accent); border-radius: 14px; background: #fff; }
  .ops-module--guest { --accent: #2563eb; }
  .ops-module--help { --accent: #f59e0b; }
  .ops-module--training { --accent: #16a34a; }
  .ops-module--quiz { --accent: #9333ea; }
  .ops-module header, .ops-list header { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 12px; }
  .ops-module h2, .ops-list h2 { margin: 0; font-size: 17px; font-weight: 700; }
  .ops-module__link { font-size: 13px; font-weight: 600; color: #2563eb; text-decoration: none; white-space: nowrap; }
  .ops-module__link:hover { text-decoration: underline; }
  .ops-module__headline { display: flex; align-items: baseline; gap: 8px; margin-bottom: 14px; }
  .ops-module__headline strong { font-size: 34px; font-weight: 800; color: var(--accent); font-variant-numeric: tabular-nums; }
  .ops-module__headline span { font-size: 13px; color: #64748b; }
  .ops-module__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0; }
  .ops-module__stats div { padding: 10px 12px; border-radius: 10px; background: #f8fafc; }
  .ops-module__stats dt { font-size: 12px; color: #64748b; }
  .ops-module__stats dd { margin: 2px 0 0; font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; }

  .ops-lists { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }
  .ops-list { padding: 20px; border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; }
  .ops-list ul { list-style: none; margin: 0; padding: 0; }
  .ops-list li + li { border-top: 1px solid #f1f5f9; }
  .ops-list__row { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 4px; text-decoration: none; color: inherit; }
  .ops-list__row:hover { background: #f8fafc; }
  .ops-list__row span:first-child { display: flex; flex-direction: column; min-width: 0; }
  .ops-list__row small { color: #64748b; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ops-badge { flex-shrink: 0; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
  .ops-badge--amber { background: #fef3c7; color: #92400e; }
  .ops-badge--blue { background: #dbeafe; color: #1e40af; }
  .ops-badge--green { background: #dcfce7; color: #166534; }
  .ops-badge--red { background: #fee2e2; color: #991b1b; }
  .ops-badge--slate { background: #f1f5f9; color: #334155; }
  .ops-empty { margin: 0; color: #64748b; font-size: 14px; }

  @media (max-width: 640px) {
    .ops-hero { padding: 20px; }
    .ops-clock { text-align: left; }
  }
</style>

<script>
  (function () {
    var clock = document.getElementById("dashboard-live-clock");
    if (!clock || clock.dataset.bound) return;
    clock.dataset.bound = "1";
    setInterval(function () {
      clock.textContent = new Date().toLocaleTimeString("en-IN", { timeZone: "Asia/Kolkata", hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: true }).toUpperCase();
    }, 1000);
  })();
</script>
